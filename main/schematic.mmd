flowchart TD
    %% Define Components
    BAT("🔋 2x AA Lithium Battery Pack\n(3.5V Total)")
    ESP{"⚙️ ESP32-C3 SuperMini"}
    REED("🧲 N/O Reed Switch")
    SENS1("🌱 Surface Soil Sensor\n(0cm)")
    %% SENS2("⛏️ Deep Soil Sensor\n(30cm)")

    %% Power Routing
    BAT -- "Red Wire (+) ➔ 3.3V Pin" --> ESP
    BAT -- "Black Wire (-) ➔ GND Pin" --> ESP

    %% Reed Switch Routing
    REED -- "Leg 1 ➔ GPIO 2" --> ESP
    REED -- "Leg 2 ➔ GND Pin" --> ESP

    %% Surface Sensor Routing (CAT5 Cable)
    ESP -- "GPIO 10 ➔ Shared VCC" --> SENS1
    ESP -- "GND Pin ➔ Shared GND" --> SENS1
    SENS1 -- "SIG Wire ➔ GPIO 0 (ADC_0)" --> ESP

    %% Deep Sensor Routing (CAT5 Cable)
    %%ESP -- "GPIO 10 ➔ Shared VCC" --> SENS2
    %%ESP -- "GND Pin ➔ Shared GND" --> SENS2
    %% SENS2 -- "SIG Wire ➔ GPIO 1 (ADC_1)" --> ESP